---
title: Personal | Haroon
layout: base.njk
permalink: /personal/
---
<h1>Personal</h1>
<ul class="post-list">
  {%- for post in collections.personal | reverse %}
  <li>
    <a href="{{ post.url }}">{{ post.data.title }}</a>
    <time datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate }}</time>
  </li>
  {%- endfor %}
</ul>
